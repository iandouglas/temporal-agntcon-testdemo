# The deployed audience site, no trailing slash.
AUDIENCE_URL=https://audience-site-production.up.railway.app

# The audience site's admin_token. Held by this process only; never sent to
# the browser.
ADMIN_TOKEN=replace-me

# Gate for the console itself. Required whenever BIND_HOST is not loopback,
# because anyone who can open this page can open the floor and toggle every
# service. Generate with: openssl rand -hex 24
# CONSOLE_TOKEN=

# Listen address. Defaults to 127.0.0.1. Railway needs "::".
# BIND_HOST=127.0.0.1

# Local port.
# PORT=4000
